{
  "version": "v1.0",
  "listeners": [
    {
      "id": "$listener",
      "doc": "Webhook listener that dispatches each inbound QuickBooks CloudEvents notification to the concrete service type matching its entity.",
      "type": {
        "name": "Listener"
      },
      "services": [
        "$companyCurrency",
        "$account",
        "$estimate",
        "$invoice",
        "$customer",
        "$taxAgency",
        "$journalEntry",
        "$item",
        "$department",
        "$refundReceipt",
        "$currency",
        "$billPayment",
        "$creditMemo",
        "$budget",
        "$preferences",
        "$timeActivity",
        "$deposit",
        "$journalCode",
        "$purchase",
        "$vendorCredit",
        "$term",
        "$vendor",
        "$payment",
        "$salesReceipt",
        "$employee",
        "$changeOrder",
        "$transfer",
        "$bill",
        "$purchaseOrder",
        "$paymentMethod",
        "$class"
      ],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": false
    }
  ],
  "serviceTypes": [
    {
      "id": "$companyCurrency",
      "doc": "Receives QuickBooks company currency events: updated, deleted, and created.",
      "type": {
        "name": "CompanyCurrencyService"
      },
      "concrete": true,
      "multipleListenersAllowed": true,
      "handlers": {
        "backedByConcreteType": true
      }
    },
    {
      "id": "$account",
      "doc": "Receives QuickBooks account events: merged, updated, created, and deleted.",
